# ============================================
# 5G-project-RTU - .gitignore
# Project: Bash scripts + Docker + Python analysis
# ============================================

# ---------- Captures & results (large/binary artifacts) ----------
# Raw packet captures are big: keep them out of Git, document them in docs/
*.pcap
*.pcapng
*.cap
captures/
results/raw/

# ---------- Scenario B (5G SA): pinned upstream clone ----------
scenario-b/upstream/

# ---------- Logs & temporary files ----------
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# ---------- Office lock/temp files ----------
.~lock.*#
~$*.doc?
~$*.xls?

# ---------- Python (analysis / plotting) ----------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.kate-swp

# ---------- OS / VM artifacts ----------
*.vdi
*.vmdk
*.iso

# ---------- Docker local overrides ----------
docker-compose.override.yml
.env

# ---------- Project 2: private inputs (brief excludes `env` and `secrets/tls/`) ----------
# Private credentials, lab CA/server keys — never committed.
env
secrets/tls/*
!secrets/tls/.gitkeep
