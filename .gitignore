# ============================================
# 5G-project-RTU - .gitignore
# Project: Bash scripts + Docker + Python analysis
# ============================================

# ---------- Captures & results (large/binary artifacts) ----------
# Raw packet captures are big: keep them out of Git, document them in docs/
*.pcap
*.pcapng
*.cap
captures/
results/raw/

# ---------- Logs & temporary files ----------
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# ---------- Office lock/temp files ----------
.~lock.*#
~$*.doc?
~$*.xls?

# ---------- Python (analysis / plotting) ----------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---------- OS / VM artifacts ----------
*.vdi
*.vmdk
*.iso

# ---------- Docker local overrides ----------
docker-compose.override.yml
.env
