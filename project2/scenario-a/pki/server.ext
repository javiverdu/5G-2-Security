# =============================================================================
# Project 2 — Scenario A lab PKI: server certificate extensions
#
# The SAN is what the UE validates: 10.20.6.20 is the only address it reaches,
# telecom-lab.local is the documented name, localhost keeps local checks honest.
# =============================================================================

[server_cert]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid, issuer

subjectAltName = @alt_names

[alt_names]
DNS.1 = telecom-lab.local
DNS.2 = localhost
IP.1  = 10.20.6.20
