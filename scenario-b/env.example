# =============================================================================
# Scenario B — parameters for the Open5GS + UERANSIM deployment
#
# Copy to `scenario-b/.env` before the first deployment:
#     cp env.example .env
# This file is copied over upstream/.env by scripts/fetch-upstream.sh, so the
# variable names MUST match the upstream project. The subscriber values are
# the public lab values from the brief; they are not secrets.
# =============================================================================

# --- Timezone ---------------------------------------------------------------
TZ=Etc/UTC

# --- PLMN / TAC (must match the UE and the gNB) -----------------------------
MCC=001
MNC=01
TAC=1

# --- 5G core network (carries N2/N3/N4/SBI) ---------------------------------
NETWORK_NAME=Open5GS
TEST_NETWORK=172.22.0.0/24
# Management address of the VM. Change it if the VM's address changes.
DOCKER_HOST_IP=192.168.56.104

# --- Core function addresses on TEST_NETWORK --------------------------------
MONGO_IP=172.22.0.2
NRF_IP=172.22.0.12
SCP_IP=172.22.0.35
AUSF_IP=172.22.0.11
UDM_IP=172.22.0.13
UDR_IP=172.22.0.14
PCF_IP=172.22.0.27
BSF_IP=172.22.0.29
NSSF_IP=172.22.0.28
SMF_IP=172.22.0.7
UPF_IP=172.22.0.8
AMF_IP=172.22.0.10
WEBUI_IP=172.22.0.26

# --- Core misc (kept from upstream; unused components can stay) -------------
HSS_IP=172.22.0.3
PCRF_IP=172.22.0.4
PCRF_BIND_PORT=3873
SGWC_IP=172.22.0.5
SGWU_IP=172.22.0.6
SGWU_ADVERTISE_IP=172.22.0.6
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4
UPF_ADVERTISE_IP=172.22.0.8
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2
MME_IP=172.22.0.9
DNS_IP=172.22.0.15
RTPENGINE_IP=172.22.0.16
MYSQL_IP=172.22.0.17
PYHSS_IP=172.22.0.18
PYHSS_BIND_PORT=3875
ICSCF_IP=172.22.0.19
ICSCF_BIND_PORT=3869
SCSCF_IP=172.22.0.20
SCSCF_BIND_PORT=3870
PCSCF_IP=172.22.0.21
PCSCF_BIND_PORT=3871
SRS_ENB_IP=172.22.0.22
OAI_ENB_IP=172.22.0.25
ENTITLEMENT_SERVER_IP=172.22.0.30
OSMOMSC_IP=172.22.0.31
OSMOHLR_IP=172.22.0.32
SMSC_IP=172.22.0.33
SRS_UE_IP=172.22.0.34
METRICS_IP=172.22.0.36
METRICS_BIND_PORT=9090
SRS_GNB_IP=172.22.0.37
IBCF_IP=172.22.0.140
GRAFANA_IP=172.22.0.39
GRAFANA_USERNAME=open5gs
GRAFANA_PASSWORD=open5gs
OCS_IP=172.22.0.40
OCS_BIND_PORT=3872
OSMOEPDG_IP=172.22.0.41
SWU_CLIENT_IP=172.22.0.42

# --- UERANSIM (gNB + UE) ----------------------------------------------------
NR_GNB_IP=172.22.0.23
NR_UE_IP=172.22.0.24

# --- Subscriber (must match the UE and the database) ------------------------
UE1_IMEI=356938035643803
UE1_IMEISV=4370816125816151
UE1_IMSI=001011234567895
UE1_KI=8baf473f2f8fd09487cccbd7097c6862
# The SIM holds OP; Open5GS stores the derived OPc.
UE1_OP=11111111111111111111111111111111
UE1_OPC=8E27B6AF0E692E750F32667A3B14605D
UE1_AMF=8000

# --- UE PDU pool ------------------------------------------------------------
UE_IPV4_INTERNET=10.45.0.0/16
UE_IPV4_IMS=10.45.1.0/24

# --- Data Network / N6 (used by the milestone-6 override) -------------------
DN_NETWORK=10.20.6.0/24
UPF_DN_IP=10.20.6.2
NGINX_IP=10.20.6.20
IPERF_IP=10.20.6.21

# --- Limits -----------------------------------------------------------------
MAX_NUM_UE=1024
